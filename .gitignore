# Regenerated outputs and caches (tens of GB): dashboards, records, per-author folders, shared parquet caches
output/
cache/
jobs/logs/

# PrizeAtlas page cache (the crawl notebook re-downloads it); the parsed CSV tables in Data/prizeatlas/ stay in the repository
Data/prizeatlas/html/

# no parquet file in the repository (every parquet table here has a CSV twin or is regenerated)
*.parquet

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.tmp
.venv/

# personal working copies of the notebooks
notebook/*[Cc]opy*.ipynb

# Preseen experiment: client state (question ids, API responses) and raw committee outputs
experiment/preseen/preseen_exp/
experiment/preseen/committee/*/raw/

# "cards as main evidence" follow-up: client state
experiment/preseen_cards_main/preseen_exp/
experiment/preseen_cards_balanced/preseen_exp/

# kept on disk, not versioned: notes and helpers of the AI-assisted sessions, title caches, originals of edited files
experiment/**/summary_ko.md
experiment/preseen/check_keys.py
experiment/preseen/dryrun_fast.py
experiment/preseen/people/*dryrun_fast*
experiment/preseen/cards*/_titles_cache.json
experiment/**/*.original.md
experiment/preseen_main_no_other/preseen_exp/
experiment/preseen_main_no_other/submit_after_profile.out
experiment/preseen_30_no_other/preseen_exp/
experiment/preseen_30_no_other/submit_after_profiles.out

# all Preseen experiment folders: client state (question and task ids), run logs, OpenAlex API / title caches
experiment/**/preseen_exp/
experiment/**/*.out
experiment/**/_titles_cache.json
experiment/**/_work/api/
